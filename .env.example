# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — real secrets must never be committed.

# Sleeper (no auth needed for the API itself).
# NOTE: Sleeper mints a NEW league id every season, so this goes stale each
# year. scripts/sleeper_settings.py looks the league up by username instead,
# so you rarely need to update it by hand. This value is the 2025 league.
SLEEPER_LEAGUE_ID=1257055387572518912

# FantasyPros API key — https://www.fantasypros.com/apis/
# The account allows 50 calls per DAY. Responses are cached in
# data/draft/fp_cache/ so a call is never spent twice. Leave blank to use the
# CSV-export path in data/inputs/ instead (see docs/DATA.md).
FANTASYPROS_API_KEY=

# ESPN — only needed for the historical dashboard, not the draft engine.
# (get these from browser cookies — see README)
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=
